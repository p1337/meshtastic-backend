diff --git a/clickbridge-kit/Sources/ClickBridgeBLE/ControllerHub.swift b/clickbridge-kit/Sources/ClickBridgeBLE/ControllerHub.swift
new file mode 100644
index 0000000..43421c0
--- /dev/null
+++ b/clickbridge-kit/Sources/ClickBridgeBLE/ControllerHub.swift
@@ -0,0 +1,418 @@
+#if canImport(CoreBluetooth)
+import Foundation
+import Combine
+@preconcurrency import CoreBluetooth
+import ClickBridgeCore
+
+public struct ControllerSnapshot: Identifiable {
+    public let id: UUID
+    public var name: String
+    public var suggestedSide: ControllerSide?
+    public var assignedSide: ControllerSide?
+    public var phase: SessionPhase = .discovered
+    public var battery: Int?
+    public var firmware: String?
+    public var hardware: String?
+    public var rssi: Int?
+    public var issue: String?
+    public var lastInput: Date?
+    public var lastButton: String?
+    public var gatt: [String] = []
+    public var shortID: String { String(id.uuidString.suffix(8)) }
+}
+
+@MainActor private final class PeripheralSession {
+    let peripheral: CBPeripheral
+    var snapshot: ControllerSnapshot
+    var machine = SessionMachine()
+    var tracker = ButtonTracker()
+    var reconnect = ReconnectPolicy()
+    var service: CBService?
+    var write: CBCharacteristic?
+    var subscriptions: Set<CBUUID> = []
+    var writes: [Data] = []
+    var deadline: DispatchWorkItem?
+    var retry: DispatchWorkItem?
+    var handshakeStarted = false
+    var connectedAt: Date?
+    var lastKeepAlive: Date?
+
+    init(_ peripheral: CBPeripheral, name: String) {
+        self.peripheral = peripheral
+        snapshot = ControllerSnapshot(id: peripheral.identifier, name: name)
+    }
+    func resetTransport() {
+        deadline?.cancel(); retry?.cancel()
+        service = nil; write = nil; subscriptions.removeAll(); writes.removeAll()
+        handshakeStarted = false; connectedAt = nil; lastKeepAlive = nil
+        tracker.reset(); snapshot.lastInput = nil; snapshot.lastButton = nil
+    }
+}
+
+/// One central, independent per-peripheral sessions. Never connects to trainers.
+// CoreBluetooth uses the main queue (queue:nil). Imported ObjC delegate requirements
+// predate Swift actor annotations; retain their runtime main-actor check explicitly.
+@MainActor public final class ControllerHub: NSObject, ObservableObject, @preconcurrency CBCentralManagerDelegate, @preconcurrency CBPeripheralDelegate {
+    @Published public private(set) var devices: [ControllerSnapshot] = []
+    @Published public private(set) var bluetoothStatus = "Bluetooth wird initialisiert"
+    @Published public private(set) var scanning = false
+    @Published public private(set) var registry: ControllerRegistry
+    public let log: DiagnosticLog
+    public var onButton: ((UUID, ControllerSide, ButtonEvent) -> Void)?
+    public var debounce: TimeInterval = 0.08
+    public var longPress: TimeInterval = 0.6
+    private var central: CBCentralManager!
+    private var sessions: [UUID: PeripheralSession] = [:]
+    private var wanted: Set<UUID>
+    private let defaults: UserDefaults
+    private let namespace: String
+    private var scanWanted = false
+    private static let notifyID = CBUUID(string: ClickGATT.notify)
+    private static let indicateID = CBUUID(string: ClickGATT.indicate)
+    private static let services = [CBUUID(string: ClickGATT.service), CBUUID(string: ClickGATT.legacyService)]
+
+    public init(namespace: String = "ClickBridge") {
+        self.namespace = namespace
+        defaults = .standard
+        if let data = defaults.data(forKey: namespace + ".registry"),
+           let stored = try? JSONDecoder().decode(ControllerRegistry.self, from: data),
+           stored.left == nil || stored.left != stored.right {
+            registry = stored
+        } else { registry = ControllerRegistry() }
+        wanted = Set((defaults.stringArray(forKey: namespace + ".wanted") ?? []).compactMap(UUID.init(uuidString:)))
+        log = DiagnosticLog(namespace: namespace)
+        super.init()
+        central = CBCentralManager(delegate: self, queue: nil, options: [
+            CBCentralManagerOptionRestoreIdentifierKey: namespace + ".central.v1",
+            CBCentralManagerOptionShowPowerAlertKey: true
+        ])
+    }
+
+    public func scan() {
+        scanWanted = true
+        guard central.state == .poweredOn else { return }
+        central.scanForPeripherals(withServices: Self.services, options: [CBCentralManagerScanOptionAllowDuplicatesKey: false])
+        scanning = true; log.record("BLE", "Suche nach FC82 / Legacy-Service")
+    }
+    public func stopScan() { scanWanted = false; central.stopScan(); scanning = false }
+
+    public func assign(_ id: UUID, to side: ControllerSide) throws {
+        try registry.assign(id, to: side)
+        persist(); publish(); log.record("Zuordnung", "\(side.rawValue) = \(short(id))")
+        connect(id)
+    }
+    public func forget(_ side: ControllerSide) {
+        if let id = registry.id(for: side) { disconnect(id) }
+        registry.remove(side); persist(); publish()
+    }
+    public func connect(_ id: UUID) {
+        guard let session = sessions[id], registry.side(for: id) != nil else { return }
+        wanted.insert(id); persist(); session.reconnect.succeeded(); session.retry?.cancel()
+        connectSession(session)
+    }
+    private func connectSession(_ session: PeripheralSession) {
+        guard central.state == .poweredOn, wanted.contains(session.peripheral.identifier) else { return }
+        if session.peripheral.state == .connecting { return }
+        if session.peripheral.state == .connected {
+            if session.machine.phase == .attention { configure(session) }
+            return
+        }
+        session.resetTransport()
+        _ = session.machine.advance(to: .connecting)
+        session.snapshot.issue = nil
+        central.connect(session.peripheral, options: nil)
+        log.record("BLE", "Verbinden \(short(session.peripheral.identifier))")
+        deadline(session, after: 25, message: "Verbindungsaufbau ohne Antwort")
+        publish()
+    }
+    public func disconnect(_ id: UUID) {
+        wanted.remove(id); persist()
+        guard let session = sessions[id] else { return }
+        session.resetTransport(); _ = session.machine.advance(to: .disconnected)
+        central.cancelPeripheralConnection(session.peripheral); publish()
+    }
+
+    /// Call when foreground resumes. This performs no continuous background scheduling.
+    public func checkHealth() {
+        for session in sessions.values where session.peripheral.state == .connected {
+            if session.machine.phase == .receiving || session.machine.phase == .awaitingInput {
+                if let connected = session.connectedAt, Date().timeIntervalSince(connected) > 60,
+                   registry.side(for: session.peripheral.identifier) == .left {
+                    session.snapshot.issue = "Linken Controller jetzt testen: zeitabhängige Sperre ist möglich."
+                }
+                if Date().timeIntervalSince(session.lastKeepAlive ?? .distantPast) > 20 {
+                    enqueue(ClickGATT.readDeviceInfo, session)
+                    session.lastKeepAlive = Date()
+                }
+            }
+        }
+        publish()
+    }
+    private func persist() {
+        if let data = try? JSONEncoder().encode(registry) { defaults.set(data, forKey: namespace + ".registry") }
+        defaults.set(wanted.map(\.uuidString), forKey: namespace + ".wanted")
+    }
+    private func short(_ id: UUID) -> String { String(id.uuidString.suffix(8)) }
+    private func publish() {
+        devices = sessions.values.map {
+            $0.snapshot.phase = $0.machine.phase
+            $0.snapshot.assignedSide = registry.side(for: $0.peripheral.identifier)
+            return $0.snapshot
+        }.sorted { $0.id.uuidString < $1.id.uuidString }
+    }
+    private func fail(_ session: PeripheralSession, _ message: String) {
+        session.deadline?.cancel(); session.machine.fail(message); session.snapshot.issue = message
+        session.tracker.reset(); session.writes.removeAll()
+        log.record("Fehler", "\(short(session.peripheral.identifier)): \(message)"); publish()
+    }
+    private func deadline(_ session: PeripheralSession, after seconds: TimeInterval, message: String) {
+        session.deadline?.cancel()
+        let task = DispatchWorkItem { [weak self, weak session] in
+            guard let self, let session else { return }
+            self.fail(session, message)
+            if session.peripheral.state == .connecting { self.central.cancelPeripheralConnection(session.peripheral) }
+        }
+        session.deadline = task
+        DispatchQueue.main.asyncAfter(deadline: .now() + seconds, execute: task)
+    }
+    private func configure(_ session: PeripheralSession) {
+        session.resetTransport()
+        session.machine = SessionMachine()
+        _ = session.machine.advance(to: .connecting)
+        _ = session.machine.advance(to: .discovering)
+        session.connectedAt = Date(); session.snapshot.issue = nil; session.snapshot.gatt = []
+        session.peripheral.delegate = self
+        session.peripheral.discoverServices(nil)
+        deadline(session, after: 20, message: "GATT-Discovery unvollständig")
+        publish()
+    }
+    private func scheduleReconnect(_ session: PeripheralSession) {
+        guard wanted.contains(session.peripheral.identifier), central.state == .poweredOn else { return }
+        guard let delay = session.reconnect.nextDelay() else {
+            fail(session, "Wiederverbindung nach 8 Versuchen gestoppt. Erneut verbinden."); return
+        }
+        log.record("Reconnect", "\(short(session.peripheral.identifier)) in \(Int(delay)) s; Ausführung im Hintergrund nicht garantiert")
+        let task = DispatchWorkItem { [weak self, weak session] in
+            guard let self, let session else { return }
+            self.connectSession(session)
+        }
+        session.retry = task
+        DispatchQueue.main.asyncAfter(deadline: .now() + delay, execute: task)
+    }
+
+    public func centralManagerDidUpdateState(_ central: CBCentralManager) {
+        switch central.state {
+        case .poweredOn:
+            bluetoothStatus = "Bluetooth bereit"
+            let identifiers = wanted.filter { registry.side(for: $0) != nil }
+            for peripheral in central.retrievePeripherals(withIdentifiers: Array(identifiers)) {
+                if sessions[peripheral.identifier] == nil {
+                    sessions[peripheral.identifier] = PeripheralSession(peripheral, name: peripheral.name ?? "Zwift Click")
+                }
+                if let session = sessions[peripheral.identifier] {
+                    if peripheral.state == .connected { configure(session) } else { connectSession(session) }
+                }
+            }
+            if scanWanted { scan() }
+        case .poweredOff: bluetoothStatus = "Bluetooth ausgeschaltet"
+        case .unauthorized: bluetoothStatus = "Bluetooth-Zugriff verweigert · iOS-Einstellungen prüfen"
+        case .unsupported: bluetoothStatus = "Bluetooth nicht unterstützt"
+        case .resetting: bluetoothStatus = "Bluetooth wird zurückgesetzt"
+        default: bluetoothStatus = "Bluetooth-Status unbekannt"
+        }
+        if central.state != .poweredOn {
+            scanning = false
+            for session in sessions.values {
+                session.resetTransport(); _ = session.machine.advance(to: .disconnected)
+            }
+        }
+        log.record("BLE", bluetoothStatus); publish()
+    }
+    public func centralManager(_ central: CBCentralManager, willRestoreState dict: [String: Any]) {
+        let restored = dict[CBCentralManagerRestoredStatePeripheralsKey] as? [CBPeripheral] ?? []
+        for peripheral in restored {
+            let session = PeripheralSession(peripheral, name: peripheral.name ?? "Zwift Click")
+            sessions[peripheral.identifier] = session; peripheral.delegate = self
+            guard wanted.contains(peripheral.identifier), registry.side(for: peripheral.identifier) != nil else {
+                central.cancelPeripheralConnection(peripheral); continue
+            }
+            if peripheral.state == .connected { configure(session) }
+            else { _ = session.machine.advance(to: .connecting) }
+        }
+        log.record("Restoration", "\(restored.count) Peripherals wiederhergestellt; GATT wird neu geprüft")
+        publish()
+    }
+    public func centralManager(_ central: CBCentralManager, didDiscover peripheral: CBPeripheral,
+                               advertisementData: [String: Any], rssi RSSI: NSNumber) {
+        let manufacturer = advertisementData[CBAdvertisementDataManufacturerDataKey] as? Data
+        let identity = manufacturer.flatMap { ManufacturerIdentity(data: $0) }
+        let name = advertisementData[CBAdvertisementDataLocalNameKey] as? String ?? peripheral.name ?? "Unbekannt"
+        guard identity != nil || name.lowercased().contains("zwift click") else { return }
+        let session = sessions[peripheral.identifier] ?? PeripheralSession(peripheral, name: name)
+        session.snapshot.suggestedSide = identity?.side
+        session.snapshot.rssi = RSSI.intValue
+        sessions[peripheral.identifier] = session
+        log.record("Gefunden", "\(name) \(short(peripheral.identifier)) Typ=\(identity?.side.rawValue ?? "unbekannt")")
+        if wanted.contains(peripheral.identifier) { connectSession(session) }
+        publish()
+    }
+    public func centralManager(_ central: CBCentralManager, didConnect peripheral: CBPeripheral) {
+        guard let session = sessions[peripheral.identifier] else { return }
+        guard wanted.contains(peripheral.identifier) else { central.cancelPeripheralConnection(peripheral); return }
+        log.record("BLE", "Verbunden \(short(peripheral.identifier))")
+        configure(session)
+    }
+    public func centralManager(_ central: CBCentralManager, didFailToConnect peripheral: CBPeripheral, error: Error?) {
+        guard let session = sessions[peripheral.identifier] else { return }
+        session.resetTransport(); _ = session.machine.advance(to: .disconnected)
+        session.snapshot.issue = error?.localizedDescription ?? "Verbindung fehlgeschlagen"
+        log.record("Fehler", session.snapshot.issue!); scheduleReconnect(session); publish()
+    }
+    public func centralManager(_ central: CBCentralManager, didDisconnectPeripheral peripheral: CBPeripheral, error: Error?) {
+        guard let session = sessions[peripheral.identifier] else { return }
+        session.resetTransport(); _ = session.machine.advance(to: .disconnected)
+        session.snapshot.issue = error?.localizedDescription
+        log.record("BLE", "Getrennt \(short(peripheral.identifier)): \(error?.localizedDescription ?? "ohne Systemfehler")")
+        scheduleReconnect(session); publish()
+    }
+
+    public func peripheral(_ peripheral: CBPeripheral, didDiscoverServices error: Error?) {
+        guard let session = sessions[peripheral.identifier], session.machine.phase == .discovering else { return }
+        if let error { fail(session, error.localizedDescription); return }
+        let services = peripheral.services ?? []
+        session.service = services.first { $0.uuid == Self.services[0] } ?? services.first { $0.uuid == Self.services[1] }
+        guard session.service != nil else { fail(session, "FC82 / proprietärer Service fehlt. Firmware oder Sperre prüfen."); return }
+        for service in services {
+            session.snapshot.gatt.append("Service \(service.uuid.uuidString)")
+            peripheral.discoverCharacteristics(nil, for: service)
+        }
+        _ = session.machine.advance(to: .subscribing); publish()
+    }
+    public func peripheral(_ peripheral: CBPeripheral, didDiscoverCharacteristicsFor service: CBService, error: Error?) {
+        guard let session = sessions[peripheral.identifier] else { return }
+        guard session.machine.phase != .disconnected, session.machine.phase != .attention else { return }
+        if let error { fail(session, error.localizedDescription); return }
+        for characteristic in service.characteristics ?? [] {
+            let uuid = characteristic.uuid
+            let description = "\(uuid.uuidString) properties=0x\(String(characteristic.properties.rawValue, radix: 16))"
+            session.snapshot.gatt.append(description); log.record("GATT", "\(short(peripheral.identifier)) \(description)")
+            if service === session.service {
+                if uuid == CBUUID(string: ClickGATT.write) { session.write = characteristic }
+                if uuid == Self.notifyID || uuid == Self.indicateID {
+                    guard characteristic.properties.contains(.notify) || characteristic.properties.contains(.indicate) else {
+                        fail(session, "Notify/Indicate-Eigenschaft fehlt: \(uuid)"); return
+                    }
+                    if characteristic.isNotifying { session.subscriptions.insert(uuid) }
+                    else { peripheral.setNotifyValue(true, for: characteristic) }
+                }
+            }
+            if [ClickGATT.battery, ClickGATT.firmware, ClickGATT.hardware].contains(uuid.uuidString) {
+                if characteristic.properties.contains(.read) { peripheral.readValue(for: characteristic) }
+                if uuid == CBUUID(string: ClickGATT.battery), characteristic.properties.contains(.notify) {
+                    peripheral.setNotifyValue(true, for: characteristic)
+                }
+            }
+        }
+        tryInitialize(session); publish()
+    }
+    public func peripheral(_ peripheral: CBPeripheral, didUpdateNotificationStateFor characteristic: CBCharacteristic, error: Error?) {
+        guard let session = sessions[peripheral.identifier] else { return }
+        if let error { fail(session, error.localizedDescription); return }
+        if characteristic.uuid == Self.notifyID || characteristic.uuid == Self.indicateID {
+            guard characteristic.service === session.service else { return }
+            guard characteristic.isNotifying else { fail(session, "Protokoll-Subscription beendet"); return }
+            session.subscriptions.insert(characteristic.uuid); tryInitialize(session)
+        }
+        publish()
+    }
+    private func tryInitialize(_ session: PeripheralSession) {
+        guard !session.handshakeStarted, session.machine.phase == .subscribing, session.write != nil,
+              session.subscriptions.contains(Self.notifyID), session.subscriptions.contains(Self.indicateID) else { return }
+        session.handshakeStarted = true
+        _ = session.machine.advance(to: .initializing)
+        enqueue(ClickGATT.initialize, session)
+        deadline(session, after: 10, message: "Kein RideOn-Handshake. Firmware/Sperre prüfen; keine Tastenausgabe freigegeben.")
+    }
+    private func enqueue(_ data: Data, _ session: PeripheralSession) {
+        guard data == ClickGATT.initialize || data == ClickGATT.readDeviceInfo else {
+            fail(session, "Nicht freigegebenes Kommando blockiert"); return
+        }
+        guard session.writes.count < 4 else { fail(session, "BLE-Schreibwarteschlange voll"); return }
+        session.writes.append(data); flush(session)
+    }
+    private func flush(_ session: PeripheralSession) {
+        guard let characteristic = session.write, session.peripheral.state == .connected else { return }
+        let noResponse = characteristic.properties.contains(.writeWithoutResponse)
+        guard noResponse || characteristic.properties.contains(.write) else { fail(session, "Schreib-Characteristic nicht beschreibbar"); return }
+        while let data = session.writes.first {
+            if noResponse && !session.peripheral.canSendWriteWithoutResponse { return }
+            let type: CBCharacteristicWriteType = noResponse ? .withoutResponse : .withResponse
+            guard data.count <= session.peripheral.maximumWriteValueLength(for: type) else { fail(session, "Kommando größer als ATT-Schreibgrenze"); return }
+            session.writes.removeFirst()
+            session.peripheral.writeValue(data, for: characteristic, type: type)
+            log.record("TX", "\(short(session.peripheral.identifier)) \(data.hex) (Transportauftrag, keine Ausführungsbestätigung)")
+            if !noResponse { return }
+        }
+    }
+    public func peripheralIsReady(toSendWriteWithoutResponse peripheral: CBPeripheral) {
+        if let session = sessions[peripheral.identifier] { flush(session) }
+    }
+    public func peripheral(_ peripheral: CBPeripheral, didWriteValueFor characteristic: CBCharacteristic, error: Error?) {
+        guard let session = sessions[peripheral.identifier] else { return }
+        if let error { fail(session, error.localizedDescription) } else { flush(session) }
+    }
+    public func peripheral(_ peripheral: CBPeripheral, didModifyServices invalidatedServices: [CBService]) {
+        guard let session = sessions[peripheral.identifier] else { return }
+        log.record("GATT", "Services invalidiert \(short(peripheral.identifier)); erneute Discovery")
+        configure(session)
+    }
+    public func peripheral(_ peripheral: CBPeripheral, didUpdateValueFor characteristic: CBCharacteristic, error: Error?) {
+        guard let session = sessions[peripheral.identifier] else { return }
+        if let error { log.record("GATT-Fehler", error.localizedDescription); return }
+        guard let data = characteristic.value else { return }
+        let uuid = characteristic.uuid
+        if uuid == CBUUID(string: ClickGATT.battery) {
+            if data.count == 1, let value = data.first, value <= 100 { session.snapshot.battery = Int(value) }
+            else { log.record("Paketfehler", "Ungültiger Standard-Batteriestatus") }
+        } else if uuid == CBUUID(string: ClickGATT.firmware) {
+            session.snapshot.firmware = String(data: data, encoding: .utf8)
+        } else if uuid == CBUUID(string: ClickGATT.hardware) {
+            session.snapshot.hardware = String(data: data, encoding: .utf8)
+        } else if (uuid == Self.notifyID || uuid == Self.indicateID), characteristic.service === session.service {
+            log.record("RX", "\(short(peripheral.identifier)) \(uuid.uuidString) \(data.prefix(512).hex)")
+            do { process(try ClickPacketDecoder.decode(data), session) }
+            catch { log.record("Paketfehler", "\(short(peripheral.identifier)) \(error)") }
+        }
+        publish()
+    }
+    private func process(_ packet: ClickPacket, _ session: PeripheralSession) {
+        switch packet {
+        case .handshake:
+            guard session.machine.phase == .initializing else { return }
+            session.deadline?.cancel(); session.reconnect.succeeded()
+            _ = session.machine.advance(to: .awaitingInput)
+            log.record("Protokoll", "Handshake erhalten \(short(session.peripheral.identifier)); Tasten und Langzeitbetrieb noch zu prüfen")
+        case .encryptionRequired: fail(session, "Verschlüsselter Handshake erforderlich; Firmware hier nicht unterstützt.")
+        case .buttons(let all, let bitmap):
+            guard session.machine.phase == .awaitingInput || session.machine.phase == .receiving,
+                  let side = registry.side(for: session.peripheral.identifier) else { return }
+            let pressed = Set(all.filter { $0.side == side })
+            session.tracker.debounce = debounce; session.tracker.longPress = longPress
+            let events = session.tracker.update(pressed, at: ProcessInfo.processInfo.systemUptime)
+            for event in events {
+                if event.phase == .down {
+                    session.snapshot.lastInput = Date(); session.snapshot.lastButton = event.button.label
+                    session.snapshot.issue = nil; _ = session.machine.advance(to: .receiving)
+                }
+                log.record("Taste", "\(side.rawValue) \(event.button.label) \(event.phase.rawValue) Dauer=\(event.duration) bitmap=\(String(bitmap, radix: 16))")
+                onButton?(session.peripheral.identifier, side, event)
+            }
+        case .battery(let level): session.snapshot.battery = level
+        case .stopped: fail(session, "Controller meldet Protokoll-Stop. Zeitabhängige Click-V2-Sperre möglich.")
+        case .lostControl: fail(session, "Controller meldet Kontrollverlust.")
+        case .idle: break
+        case .unknown(let opcode, _): log.record("Unbekannt", "Opcode 0x\(String(opcode, radix: 16)); keine Aktion")
+        }
+    }
+}
+#endif
diff --git a/clickbridge-kit/Sources/ClickBridgeBLE/DiagnosticLog.swift b/clickbridge-kit/Sources/ClickBridgeBLE/DiagnosticLog.swift
new file mode 100644
index 0000000..f6e4d36
--- /dev/null
+++ b/clickbridge-kit/Sources/ClickBridgeBLE/DiagnosticLog.swift
@@ -0,0 +1,62 @@
+#if canImport(CoreBluetooth)
+import Foundation
+import Combine
+
+public struct DiagnosticEntry: Identifiable, Codable, Sendable {
+    public let id: UUID
+    public let time: Date
+    public let category: String
+    public let message: String
+}
+
+@MainActor public final class DiagnosticLog: ObservableObject {
+    @Published public private(set) var entries: [DiagnosticEntry] = []
+    public private(set) var storageError: String?
+    private let directory: URL
+    private let file: URL
+    private let maximumBytes = 2 * 1024 * 1024
+
+    public init(namespace: String) {
+        directory = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent(namespace, isDirectory: true)
+        file = directory.appendingPathComponent("ble.jsonl")
+        do { try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true) }
+        catch { storageError = error.localizedDescription }
+    }
+
+    public func record(_ category: String, _ message: String) {
+        let entry = DiagnosticEntry(id: UUID(), time: Date(), category: category,
+                                    message: String(message.prefix(3000)))
+        entries.append(entry)
+        if entries.count > 600 { entries.removeFirst(entries.count - 600) }
+        do {
+            if let size = try? file.resourceValues(forKeys: [.fileSizeKey]).fileSize, size >= maximumBytes {
+                let previous = directory.appendingPathComponent("ble.previous.jsonl")
+                try? FileManager.default.removeItem(at: previous)
+                try FileManager.default.moveItem(at: file, to: previous)
+            }
+            if !FileManager.default.fileExists(atPath: file.path) {
+                try Data().write(to: file, options: .atomic)
+                #if os(iOS)
+                try FileManager.default.setAttributes([.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication], ofItemAtPath: file.path)
+                #endif
+            }
+            let encoder = JSONEncoder(); encoder.dateEncodingStrategy = .iso8601
+            var data = try encoder.encode(entry); data.append(0x0A)
+            let handle = try FileHandle(forWritingTo: file)
+            defer { try? handle.close() }
+            try handle.seekToEnd(); try handle.write(contentsOf: data)
+        } catch { storageError = error.localizedDescription }
+    }
+
+    public func export() throws -> URL {
+        let destination = FileManager.default.temporaryDirectory.appendingPathComponent("ClickBridge-Diagnose.jsonl")
+        var output = Data("{\"notice\":\"BLE software observations only; no hardware acceptance claim\"}\n".utf8)
+        let previous = directory.appendingPathComponent("ble.previous.jsonl")
+        if let old = try? Data(contentsOf: previous) { output.append(old) }
+        if FileManager.default.fileExists(atPath: file.path) { output.append(try Data(contentsOf: file)) }
+        try output.write(to: destination, options: .atomic)
+        return destination
+    }
+}
+#endif
diff --git a/clickbridge-kit/Sources/ClickBridgeCore/ClickProtocol.swift b/clickbridge-kit/Sources/ClickBridgeCore/ClickProtocol.swift
new file mode 100644
index 0000000..96f0d62
--- /dev/null
+++ b/clickbridge-kit/Sources/ClickBridgeCore/ClickProtocol.swift
@@ -0,0 +1,136 @@
+import Foundation
+
+// Wire constants and active-low bitmap interpretation reference TrainerHUD (MIT).
+// See THIRD_PARTY_NOTICES.md. Parser and error handling are implemented independently.
+public enum ClickGATT {
+    public static let service = "FC82"
+    public static let legacyService = "00000001-19CA-4651-86E5-FA29DCDD09D1"
+    public static let notify = "00000002-19CA-4651-86E5-FA29DCDD09D1"
+    public static let write = "00000003-19CA-4651-86E5-FA29DCDD09D1"
+    public static let indicate = "00000004-19CA-4651-86E5-FA29DCDD09D1"
+    public static let battery = "2A19", firmware = "2A26", hardware = "2A27"
+    /// Only these source-backed application commands are transmitted.
+    public static let initialize = Data([0x52, 0x69, 0x64, 0x65, 0x4F, 0x6E])
+    public static let readDeviceInfo = Data([0x00, 0x08, 0x00])
+}
+
+public enum PacketError: Error, Equatable, CustomStringConvertible {
+    case empty, tooLarge, truncated, varintOverflow, invalidField, unsupportedWire
+    case missingBitmap, duplicateBitmap, invalidValue
+    public var description: String {
+        switch self {
+        case .empty: return "Leeres Paket"
+        case .tooLarge: return "Paket größer als 512 Bytes"
+        case .truncated: return "Unvollständiges Paket"
+        case .varintOverflow: return "Protobuf-Varint-Überlauf"
+        case .invalidField: return "Ungültige Protobuf-Feldnummer"
+        case .unsupportedWire: return "Nicht unterstützter Protobuf-Wire-Typ"
+        case .missingBitmap: return "Tasten-Bitmap fehlt"
+        case .duplicateBitmap: return "Mehrdeutige Tasten-Bitmap"
+        case .invalidValue: return "Ungültiger Protokollwert"
+        }
+    }
+}
+
+public enum ClickPacket: Equatable, Sendable {
+    case handshake
+    case encryptionRequired
+    case buttons(Set<ClickButton>, bitmap: UInt32)
+    case battery(Int)
+    case idle
+    case stopped
+    case lostControl
+    case unknown(UInt8, Data)
+}
+
+private struct Field {
+    let number: UInt64
+    let wire: UInt8
+    let value: UInt64?
+}
+
+/// Bounded protobuf wire reader. Incomplete frames are never decoded as presses.
+private enum Wire {
+    static func fields(_ data: Data) throws -> [Field] {
+        let bytes = Array(data)
+        var i = 0
+        func varint() throws -> UInt64 {
+            var value: UInt64 = 0
+            for index in 0..<10 {
+                guard i < bytes.count else { throw PacketError.truncated }
+                let byte = bytes[i]; i += 1
+                if index == 9, byte > 1 { throw PacketError.varintOverflow }
+                value |= UInt64(byte & 0x7F) << UInt64(index * 7)
+                if byte & 0x80 == 0 { return value }
+            }
+            throw PacketError.varintOverflow
+        }
+        func skip(_ count: Int) throws {
+            guard count <= bytes.count - i else { throw PacketError.truncated }
+            i += count
+        }
+        var result: [Field] = []
+        while i < bytes.count {
+            let tag = try varint()
+            let number = tag >> 3
+            guard number > 0, number <= 536_870_911 else { throw PacketError.invalidField }
+            let wire = UInt8(tag & 7)
+            var value: UInt64?
+            switch wire {
+            case 0: value = try varint()
+            case 1: try skip(8)
+            case 2:
+                let count = try varint()
+                guard count <= UInt64(bytes.count - i) else { throw PacketError.truncated }
+                try skip(Int(count))
+            case 5: try skip(4)
+            default: throw PacketError.unsupportedWire
+            }
+            result.append(Field(number: number, wire: wire, value: value))
+        }
+        return result
+    }
+}
+
+public enum ClickPacketDecoder {
+    public static func decode(_ data: Data) throws -> ClickPacket {
+        guard !data.isEmpty else { throw PacketError.empty }
+        guard data.count <= 512 else { throw PacketError.tooLarge }
+        if data.starts(with: ClickGATT.initialize) {
+            if data.count > 8 { return .encryptionRequired }
+            if data == ClickGATT.initialize || data == ClickGATT.initialize + Data([0x02, 0x03]) {
+                return .handshake
+            }
+            throw PacketError.invalidValue
+        }
+        let opcode = data[data.startIndex]
+        let payload = Data(data.dropFirst())
+        switch opcode {
+        case 0x23:
+            let fields = try Wire.fields(payload)
+            let maps = fields.filter { $0.number == 1 }
+            guard !maps.isEmpty else { throw PacketError.missingBitmap }
+            guard maps.count == 1 else { throw PacketError.duplicateBitmap }
+            guard let raw = maps[0].value, raw <= UInt64(UInt32.max) else { throw PacketError.invalidValue }
+            let bitmap = UInt32(raw)
+            let pressed = Set(ClickButton.allCases.filter { bitmap & $0.rawValue == 0 })
+            return .buttons(pressed, bitmap: bitmap)
+        case 0x19:
+            let fields = try Wire.fields(payload).filter { $0.number == 2 }
+            guard fields.count == 1, let percent = fields[0].value, percent <= 100 else { throw PacketError.invalidValue }
+            return .battery(Int(percent))
+        case 0x15: return .idle
+        case 0xFE: return .lostControl
+        case 0xFF:
+            if data == Data([0xFF, 0x05, 0x00, 0xEA, 0x05]) || data == Data([0xFF, 0x05, 0x00, 0xFA, 0x05]) {
+                return .stopped
+            }
+            return .unknown(opcode, payload)
+        default: return .unknown(opcode, payload)
+        }
+    }
+}
+
+public extension Data {
+    var hex: String { map { String(format: "%02X", $0) }.joined(separator: " ") }
+}
diff --git a/clickbridge-kit/Sources/ClickBridgeCore/Controller.swift b/clickbridge-kit/Sources/ClickBridgeCore/Controller.swift
new file mode 100644
index 0000000..3698f47
--- /dev/null
+++ b/clickbridge-kit/Sources/ClickBridgeCore/Controller.swift
@@ -0,0 +1,161 @@
+import Foundation
+
+public enum ControllerSide: String, Codable, CaseIterable, Sendable {
+    case left, right
+    public var label: String { self == .left ? "Links" : "Rechts" }
+}
+
+public enum ClickButton: UInt32, Codable, CaseIterable, Sendable {
+    case left = 1, up = 2, right = 4, down = 8
+    case a = 16, b = 32, y = 64, z = 128
+    case minus = 256, plus = 4096
+
+    public var label: String {
+        switch self {
+        case .left: return "←"
+        case .up: return "↑"
+        case .right: return "→"
+        case .down: return "↓"
+        case .a: return "A"
+        case .b: return "B"
+        case .y: return "Y"
+        case .z: return "Z"
+        case .minus: return "−"
+        case .plus: return "+"
+        }
+    }
+    public var side: ControllerSide {
+        switch self {
+        case .left, .up, .right, .down, .minus: return .left
+        default: return .right
+        }
+    }
+}
+
+public struct ManufacturerIdentity: Equatable, Sendable {
+    public let side: ControllerSide
+    public init?(data: Data) {
+        let bytes = Array(data)
+        guard bytes.count >= 3, bytes[0] == 0x4A, bytes[1] == 0x09 else { return nil }
+        switch bytes[2] {
+        case 0x0A: side = .right
+        case 0x0B: side = .left
+        default: return nil
+        }
+    }
+}
+
+public enum AssignmentError: Error, Equatable { case sideOccupied, deviceAlreadyAssigned }
+
+public struct ControllerRegistry: Codable, Equatable, Sendable {
+    public private(set) var left: UUID?
+    public private(set) var right: UUID?
+    public init() {}
+    public func id(for side: ControllerSide) -> UUID? { side == .left ? left : right }
+    public func side(for id: UUID) -> ControllerSide? {
+        if left == id { return .left }
+        if right == id { return .right }
+        return nil
+    }
+    public mutating func assign(_ id: UUID, to side: ControllerSide) throws {
+        if let current = self.side(for: id), current != side { throw AssignmentError.deviceAlreadyAssigned }
+        if let current = self.id(for: side), current != id { throw AssignmentError.sideOccupied }
+        if side == .left { left = id } else { right = id }
+    }
+    public mutating func remove(_ side: ControllerSide) {
+        if side == .left { left = nil } else { right = nil }
+    }
+}
+
+public enum ButtonPhase: String, Codable, Sendable { case down, up, longPress }
+public struct ButtonEvent: Equatable, Sendable {
+    public let button: ClickButton
+    public let phase: ButtonPhase
+    public let duration: TimeInterval
+}
+
+/// Leading-edge presses, duplicate-frame suppression and long press on release.
+/// No timer or guessed release: a missing release is not a second press.
+public struct ButtonTracker: Sendable {
+    public var debounce: TimeInterval = 0.08
+    public var longPress: TimeInterval = 0.6
+    private var held: [ClickButton: TimeInterval] = [:]
+    private var lastAccepted: [ClickButton: TimeInterval] = [:]
+    private var previous: Set<ClickButton> = []
+    public init() {}
+
+    public mutating func update(_ pressed: Set<ClickButton>, at now: TimeInterval) -> [ButtonEvent] {
+        var events: [ButtonEvent] = []
+        for button in previous.subtracting(pressed).sorted(by: { $0.rawValue < $1.rawValue }) {
+            if let start = held.removeValue(forKey: button) {
+                let duration = max(0, now - start)
+                events.append(ButtonEvent(button: button, phase: .up, duration: duration))
+                if duration >= longPress {
+                    events.append(ButtonEvent(button: button, phase: .longPress, duration: duration))
+                }
+            }
+        }
+        for button in pressed.subtracting(previous).sorted(by: { $0.rawValue < $1.rawValue }) {
+            guard now - (lastAccepted[button] ?? -.infinity) >= debounce else { continue }
+            held[button] = now
+            lastAccepted[button] = now
+            events.append(ButtonEvent(button: button, phase: .down, duration: 0))
+        }
+        previous = pressed
+        return events
+    }
+    public mutating func reset() {
+        held.removeAll(); previous.removeAll(); lastAccepted.removeAll()
+    }
+}
+
+public struct ReconnectPolicy: Equatable, Sendable {
+    public private(set) var failures = 0
+    public let maximumAttempts: Int
+    public init(maximumAttempts: Int = 8) { self.maximumAttempts = max(1, maximumAttempts) }
+    public mutating func nextDelay() -> TimeInterval? {
+        guard failures < maximumAttempts else { return nil }
+        let delay = min(60.0, pow(2.0, Double(failures)))
+        failures += 1
+        return delay
+    }
+    public mutating func succeeded() { failures = 0 }
+}
+
+public enum SessionPhase: String, Codable, Sendable {
+    case discovered, connecting, discovering, subscribing, initializing
+    case awaitingInput, receiving, attention, disconnected
+    public var label: String {
+        switch self {
+        case .discovered: return "Gefunden"
+        case .connecting: return "Verbinden"
+        case .discovering: return "GATT prüfen"
+        case .subscribing: return "Notifications aktivieren"
+        case .initializing: return "Initialisieren"
+        case .awaitingInput: return "Handshake erhalten · Taste drücken"
+        case .receiving: return "Tasten empfangen"
+        case .attention: return "Prüfung erforderlich"
+        case .disconnected: return "Getrennt"
+        }
+    }
+}
+
+public struct SessionMachine: Sendable {
+    public private(set) var phase: SessionPhase = .discovered
+    public private(set) var reason: String?
+    public init() {}
+    @discardableResult public mutating func advance(to next: SessionPhase) -> Bool {
+        let permitted: Bool
+        switch (phase, next) {
+        case (_, .disconnected), (_, .attention): permitted = true
+        case (.discovered, .connecting), (.disconnected, .connecting), (.attention, .connecting),
+             (.connecting, .discovering), (.discovering, .subscribing),
+             (.subscribing, .initializing), (.initializing, .awaitingInput),
+             (.awaitingInput, .receiving), (.receiving, .receiving): permitted = true
+        default: permitted = false
+        }
+        if permitted { phase = next; reason = nil }
+        return permitted
+    }
+    public mutating func fail(_ message: String) { phase = .attention; reason = message }
+}
diff --git a/clickbridge-kit/Sources/ClickBridgeCore/Gearing.swift b/clickbridge-kit/Sources/ClickBridgeCore/Gearing.swift
new file mode 100644
index 0000000..e4e5e52
--- /dev/null
+++ b/clickbridge-kit/Sources/ClickBridgeCore/Gearing.swift
@@ -0,0 +1,105 @@
+import Foundation
+
+public enum ShiftDirection: Int, Codable, CaseIterable, Sendable {
+    case down = -1, up = 1
+    public var label: String { self == .up ? "Hochschalten" : "Herunterschalten" }
+}
+
+public struct ButtonBinding: Codable, Equatable, Sendable {
+    public var button: ClickButton
+    public var direction: ShiftDirection
+    public init(button: ClickButton, direction: ShiftDirection) { self.button = button; self.direction = direction }
+}
+
+public enum GearError: Error, Equatable {
+    case invalidCount, invalidRatios, invalidStart, invalidTiming, invalidBindings
+    case noIntegration, busy, rateLimited, boundary, staleAcknowledgement
+}
+
+public struct GearConfiguration: Codable, Equatable, Sendable {
+    public var ratios: [Double]
+    public var startGear: Int
+    public var shiftInterval: TimeInterval
+    public var debounce: TimeInterval
+    public var longPress: TimeInterval
+    public var bindings: [ButtonBinding]
+    public var count: Int { ratios.count }
+    public static var standard: GearConfiguration {
+        GearConfiguration(ratios: (0..<24).map { 0.75 * pow(6.0, Double($0) / 23.0) },
+                          startGear: 12, shiftInterval: 0.12, debounce: 0.08, longPress: 0.6,
+                          bindings: [.init(button: .minus, direction: .down), .init(button: .plus, direction: .up)])
+    }
+    public func validate() throws {
+        guard (2...64).contains(count) else { throw GearError.invalidCount }
+        guard ratios.allSatisfy({ $0.isFinite && (0.05...20).contains($0) }),
+              zip(ratios, ratios.dropFirst()).allSatisfy({ $0.0 < $0.1 }) else { throw GearError.invalidRatios }
+        guard (1...count).contains(startGear) else { throw GearError.invalidStart }
+        guard shiftInterval.isFinite, (0...2).contains(shiftInterval),
+              debounce.isFinite, (0.01...0.5).contains(debounce),
+              longPress.isFinite, (0.3...3).contains(longPress) else { throw GearError.invalidTiming }
+        guard Set(bindings.map(\.button)).count == bindings.count else { throw GearError.invalidBindings }
+    }
+    public func direction(for event: ButtonEvent) -> ShiftDirection? {
+        guard event.phase == .down else { return nil }
+        return bindings.first { $0.button == event.button }?.direction
+    }
+    public mutating func resize(_ count: Int) throws {
+        guard (2...64).contains(count), let low = ratios.first, let high = ratios.last else { throw GearError.invalidCount }
+        ratios = (0..<count).map { low * pow(high / low, Double($0) / Double(count - 1)) }
+        startGear = min(count, max(1, startGear))
+        try validate()
+    }
+}
+
+public struct ShiftRequest: Equatable, Sendable {
+    public let id: UUID
+    public let gear: Int
+    public let ratio: Double
+    public let direction: ShiftDirection
+}
+
+/// A transport acceptance is not a measurement of physical trainer resistance.
+public enum DeliveryEvidence: String, Codable, Sendable { case softwareAccepted }
+
+public struct GearEngine: Sendable {
+    public let configuration: GearConfiguration
+    public private(set) var acceptedGear: Int?
+    public private(set) var pending: ShiftRequest?
+    private var lastAcceptedAt: TimeInterval?
+
+    public init(configuration: GearConfiguration = .standard, lastAcceptedGear: Int? = nil) throws {
+        try configuration.validate()
+        self.configuration = configuration
+        acceptedGear = lastAcceptedGear.flatMap { (1...configuration.count).contains($0) ? $0 : nil }
+    }
+    public mutating func request(_ direction: ShiftDirection, at now: TimeInterval, integrationAvailable: Bool) throws -> ShiftRequest {
+        guard integrationAvailable else { throw GearError.noIntegration }
+        guard pending == nil else { throw GearError.busy }
+        if let lastAcceptedAt, now - lastAcceptedAt < configuration.shiftInterval { throw GearError.rateLimited }
+        let gear = (acceptedGear ?? configuration.startGear) + direction.rawValue
+        guard (1...configuration.count).contains(gear) else { throw GearError.boundary }
+        let request = ShiftRequest(id: UUID(), gear: gear, ratio: configuration.ratios[gear - 1], direction: direction)
+        pending = request
+        return request
+    }
+    public mutating func acknowledge(_ request: ShiftRequest, evidence: DeliveryEvidence, at now: TimeInterval) throws {
+        guard pending == request else { throw GearError.staleAcknowledgement }
+        acceptedGear = request.gear; lastAcceptedAt = now; pending = nil
+    }
+    public mutating func reject(_ request: ShiftRequest) {
+        if pending?.id == request.id { pending = nil }
+    }
+}
+
+public struct SavedSettings: Codable, Equatable, Sendable {
+    public var gearing: GearConfiguration = .standard
+    /// Last software-accepted gear; it is never presented as a live trainer readout.
+    public var lastAcceptedGear: Int?
+    public init() {}
+    public static func restore(from data: Data?) -> SavedSettings {
+        guard let data, var result = try? JSONDecoder().decode(SavedSettings.self, from: data),
+              (try? result.gearing.validate()) != nil else { return SavedSettings() }
+        if let gear = result.lastAcceptedGear, !(1...result.gearing.count).contains(gear) { result.lastAcceptedGear = nil }
+        return result
+    }
+}
