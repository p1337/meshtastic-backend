@@ -0,0 +1,12 @@
+export interface ShiftMessage { id: string; session: string; direction: 1 | -1; emittedAtMs: number }
+export interface ShiftResult { status: 'submitted' | 'rejected'; reason?: string; gearDisplay?: string; evidence?: string }
+export interface ShiftDependencies {
+    active(): boolean; session(): string | null; targetCount(): number;
+    virtualShiftingEnabled(): boolean; busy(): boolean; gearDisplay(): unknown;
+    sendUpdate(request: { gearDelta: number }): Promise<void>;
+    now?(): number;
+}
+export function createShiftRouter(dependencies: ShiftDependencies): {
+    handle(event: ShiftMessage): Promise<ShiftResult>;
+    close(): void;
+};
diff --git a/src/integrations/clickbridge/shiftRouter.js b/src/integrations/clickbridge/shiftRouter.js
new file mode 100644
index 0000000..496c4e1
--- /dev/null
+++ b/src/integrations/clickbridge/shiftRouter.js
@@ -0,0 +1,49 @@
+'use strict';
+
+// Runs INSIDE Incyclist. This is not an IPC endpoint in the standalone app.
+function createShiftRouter(dependencies) {
+    const now = dependencies.now || Date.now;
+    const seen = new Set();
+    let tail = Promise.resolve();
+    let queued = 0;
+    let closed = false;
+
+    function reject(reason) { return { status: 'rejected', reason }; }
+    function handle(event) {
+        if (!event || typeof event.id !== 'string' || event.id.length > 80 ||
+            typeof event.session !== 'string' || !Number.isFinite(event.emittedAtMs) ||
+            (event.direction !== 1 && event.direction !== -1)) {
+            return Promise.resolve(reject('invalid-event'));
+        }
+        if (closed) return Promise.resolve(reject('closed'));
+        if (seen.has(event.id)) return Promise.resolve(reject('duplicate'));
+        seen.add(event.id);
+        if (seen.size > 256) seen.delete(seen.values().next().value);
+        if (queued >= 8) return Promise.resolve(reject('queue-full'));
+        // Capture primitives; do not retain a caller-mutable native event object.
+        const input = { id: event.id, session: event.session,
+            direction: event.direction, emittedAtMs: event.emittedAtMs };
+        queued += 1;
+        const work = tail.then(async () => {
+            if (closed || !dependencies.active()) return reject('inactive-ride');
+            if (input.session !== dependencies.session()) return reject('stale-session');
+            const age = now() - input.emittedAtMs;
+            if (age > 1500 || age < -250) return reject('expired-event');
+            if (dependencies.targetCount() !== 1) return reject('requires-one-started-control-adapter');
+            if (!dependencies.virtualShiftingEnabled()) return reject('virtual-shifting-disabled-or-erg');
+            if (dependencies.busy()) return reject('trainer-update-busy');
+            try {
+                // Existing Incyclist path owns both route simulation and gear deltas.
+                await dependencies.sendUpdate({ gearDelta: input.direction });
+                return { status: 'submitted', gearDisplay: String(dependencies.gearDisplay() ?? ''),
+                    evidence: 'incyclist-software-path-only' };
+            } catch (error) {
+                return reject('send-update-error: ' + String(error));
+            }
+        });
+        tail = work.then(() => undefined, () => undefined);
+        return work.finally(() => { queued -= 1; });
+    }
+    return { handle, close() { closed = true; } };
+}
+module.exports = { createShiftRouter };
diff --git a/src/integrations/clickbridge/shiftRouter.test.cjs b/src/integrations/clickbridge/shiftRouter.test.cjs
new file mode 100644
index 0000000..12ea4d8
--- /dev/null
+++ b/src/integrations/clickbridge/shiftRouter.test.cjs
@@ -0,0 +1,71 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createShiftRouter } = require('./shiftRouter.js');
+
+function fixture(overrides = {}) {
+    const calls = [];
+    const dependencies = { active: () => true, session: () => 'ride-1', targetCount: () => 1,
+        virtualShiftingEnabled: () => true, busy: () => false, gearDisplay: () => '13',
+        now: () => 1000, sendUpdate: async request => { calls.push(request); }, ...overrides };
+    return { calls, dependencies, router: createShiftRouter(dependencies) };
+}
+const event = (id = '1', direction = 1) => ({ id, direction, session: 'ride-1', emittedAtMs: 1000 });
+
+test('routes both directions through existing Incyclist path, no slope override', async () => {
+    const { calls, router } = fixture();
+    assert.equal((await router.handle(event())).status, 'submitted');
+    assert.equal((await router.handle(event('2', -1))).evidence, 'incyclist-software-path-only');
+    assert.deepEqual(calls, [{ gearDelta: 1 }, { gearDelta: -1 }]);
+});
+test('suppresses duplicate native events', async () => {
+    const { calls, router } = fixture();
+    await router.handle(event());
+    assert.equal((await router.handle(event())).reason, 'duplicate');
+    assert.equal(calls.length, 1);
+});
+test('rejects invalid, expired and future events', async () => {
+    const { calls, router } = fixture();
+    assert.equal((await router.handle({ ...event(), direction: 4 })).reason, 'invalid-event');
+    assert.equal((await router.handle({ ...event('old'), emittedAtMs: -1000 })).reason, 'expired-event');
+    assert.equal((await router.handle({ ...event('future'), emittedAtMs: 5000 })).reason, 'expired-event');
+    assert.equal(calls.length, 0);
+});
+test('rejects stale ride session and events after cleanup', async () => {
+    const { calls, router } = fixture();
+    assert.equal((await router.handle({ ...event(), session: 'old-ride' })).reason, 'stale-session');
+    router.close();
+    assert.equal((await router.handle(event('2'))).reason, 'closed');
+    assert.equal(calls.length, 0);
+});
+test('gates inactive rides, ERG, disabled shifting, missing and multiple trainers', async () => {
+    for (const overrides of [{ active: () => false }, { virtualShiftingEnabled: () => false },
+        { targetCount: () => 0 }, { targetCount: () => 2 }, { busy: () => true }]) {
+        const { calls, router } = fixture(overrides);
+        assert.equal((await router.handle(event())).status, 'rejected');
+        assert.equal(calls.length, 0);
+    }
+});
+test('serializes requests and recovers after transport error', async () => {
+    let inFlight = 0, maxInFlight = 0, number = 0;
+    const { router } = fixture({ sendUpdate: async () => {
+        inFlight++; maxInFlight = Math.max(maxInFlight, inFlight);
+        await new Promise(resolve => setTimeout(resolve, 2));
+        inFlight--; if (number++ === 0) throw Error('test failure');
+    } });
+    const results = await Promise.all([router.handle(event('1')), router.handle(event('2'))]);
+    assert.equal(maxInFlight, 1); assert.equal(results[0].status, 'rejected');
+    assert.equal(results[1].status, 'submitted');
+});
+test('rechecks state at execution time and bounds queue', async () => {
+    let resolve;
+    const { router, calls, dependencies } = fixture({ sendUpdate: () => new Promise(r => { resolve = r; }) });
+    const first = router.handle(event());
+    await new Promise(r => setImmediate(r));
+    const rest = Array.from({ length: 8 }, (_, i) => router.handle(event('queued-' + i)));
+    dependencies.active = () => false;
+    resolve(); await first;
+    const results = await Promise.all(rest);
+    assert.equal(results.filter(r => r.reason === 'queue-full').length, 1);
+    assert.equal(results.filter(r => r.reason === 'inactive-ride').length, 7);
+    assert.equal(calls.length, 0);
+});
